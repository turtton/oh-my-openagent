+  }
+
+  unregisterBlockingTask(taskId: string): void {
+    const current = this.blockingTaskRefCounts.get(taskId) ?? 0
+    if (current <= 1) {
+      this.blockingTaskRefCounts.delete(taskId)
+    } else {
+      this.blockingTaskRefCounts.set(taskId, current - 1)
+    }
+  }
+
+  isTaskBlocking(taskId: string): boolean {
